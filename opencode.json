{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git add*": "ask",
      "git commit*": "ask",
      "git push*": "ask",
      "git checkout*": "ask",
      "git switch*": "ask",
      "ls*": "allow",
      "cat*": "allow"
    },
    "webfetch": "ask",
    "external_directory": "deny"
  }
}
